{
  "name": "openkee-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API-powered tools and utilities by OpenKee.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:logic && npm run test:components",
    "test:logic": "node --test tests/all.test.mjs",
    "test:components": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "chart.js": "^4.6.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "satellite.js": "^7.1.0",
    "suncalc": "^2.1.1",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
